<?xml version="1.0" encoding="utf-8"?>
<!-- Автокопия Android (Google Диск): всё, кроме паролей — их ключ не переносится между телефонами -->
<full-backup-content>
    <exclude domain="file" path="vault.key" />
    <exclude domain="file" path="vault.dat" />
    <exclude domain="file" path="vault.dat.tmp" />
    <!-- офлайн-карты: большие и скачиваются заново -->
    <exclude domain="file" path="mbgl-offline.db" />
    <exclude domain="file" path=".mbgl-offline.db" />
    <exclude domain="file" path="map/" />
    <exclude domain="external" path="maps/" />
</full-backup-content>
