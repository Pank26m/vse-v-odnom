<?xml version="1.0" encoding="utf-8"?>
<!-- Автокопия Android (Google Диск): всё, кроме паролей — их ключ не переносится между телефонами -->
<full-backup-content>
    <exclude domain="file" path="vault.key" />
    <exclude domain="file" path="vault.dat" />
    <exclude domain="file" path="vault.dat.tmp" />
    <exclude domain="file" path="vault_files/" />
    <exclude domain="file" path="tg/" />
    <!-- офлайн-карты: большие и скачиваются заново -->
    <exclude domain="file" path="mbgl-offline.db" />
    <exclude domain="file" path=".mbgl-offline.db" />
    <exclude domain="file" path="map/" />
    <exclude domain="file" path="gcache/" />
    <exclude domain="file" path="callrec/" />
    <exclude domain="external" path="maps/" />
    <!-- GLMap: кэш тайлов и рельефа, онлайн-карты, рельеф мира, мир -->
    <exclude domain="file" path="tileCache.db" />
    <exclude domain="file" path="elevationCache.db" />
    <exclude domain="file" path="world.vm" />
    <exclude domain="file" path="raster/" />
    <exclude domain="file" path="relief/" />
</full-backup-content>
